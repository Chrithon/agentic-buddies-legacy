# agentic-buddies-backend 环境变量模板
# 复制为 .env 后填写；.env 已被 .gitignore 忽略。

# PostgreSQL 连接串（必须与 core/conf.yaml 的 database 段指向同一数据库）
DATABASE_URL=postgresql+asyncpg://ab_admin:change-me@localhost:5432/ab_database

# JWT 签名密钥。建议设置固定随机值；留空则每次启动随机生成，重启后所有 token 失效。
# SECRET_KEY=change-me-to-a-long-random-string

# 允许的前端源（逗号分隔；默认仅 localhost:5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
